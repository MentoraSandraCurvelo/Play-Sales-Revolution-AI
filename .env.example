# ─── Meta / WhatsApp Cloud API ──────────────────────────────────────────────
# Token del System User (permanente). Meta > Business Settings > Usuarios del sistema.
WHATSAPP_TOKEN=
# ID del número de teléfono. Meta for Developers > WhatsApp > Configuración de la API.
WHATSAPP_PHONE_NUMBER_ID=
# Una frase que tú inventas. La escribes aquí Y en la config del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# App Secret. Meta for Developers > Configuración de la app > Básica.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# ─── Claude ─────────────────────────────────────────────────────────────────
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-opus-5
# low | medium | high  (low = rápido y económico, ideal para chat)
AGENTE_ESFUERZO=low

# ─── Negocio ────────────────────────────────────────────────────────────────
NOMBRE_NEGOCIO=IAM · Sandra Curvelo
# Tu enlace de Calendly. Déjalo vacío si aún no quieres compartirlo.
LINK_AGENDA=
NUMERO_ESCALAMIENTO=

# ─── Operación ──────────────────────────────────────────────────────────────
DB_PATH=whatsapp_agent.db
MAX_TURNOS_HISTORIAL=20
# Inventa una clave larga para consultar /leads y /reanudar. Vacío = endpoints apagados.
ADMIN_TOKEN=
