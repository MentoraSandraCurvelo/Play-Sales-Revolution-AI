# =====================================================================
# Junta Directiva Agéntica IAM™ — variables de entorno
# Copia este archivo a `.env` y completa lo que tengas.
#
# Todo es opcional salvo ANTHROPIC_API_KEY. Cada conector que falte
# simplemente no se monta: la junta arranca igual y te dice qué le falta.
# =====================================================================

# --- Anthropic (OBLIGATORIO) -----------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase: memoria de la junta -----------------------------------
# Project Settings → API. Usa la SERVICE ROLE KEY, no la anon.
# ⚠️ La service role key omite RLS. Nunca la subas a un repositorio ni
#    la expongas en el navegador.
# Antes de la primera sesión, ejecuta junta/memoria/schema.sql en el
# SQL Editor de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJ...

# --- Airtable: pipeline y clientes -----------------------------------
# https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=pat...

# --- Notion: procesos y documentación --------------------------------
# https://www.notion.so/my-integrations
# Recuerda compartir con la integración las páginas que deba leer.
NOTION_TOKEN=ntn_...

# --- Google: Gmail + Drive -------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo "Desktop app"). Luego genera el refresh token con OAuth Playground
# (https://developers.google.com/oauthplayground, activando "Use your own
# OAuth credentials").
# Scopes necesarios:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send      (solo si usarás modo ejecución)
#   https://www.googleapis.com/auth/drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- WhatsApp Cloud API ----------------------------------------------
# https://developers.facebook.com → tu app → WhatsApp → API Setup
# Nota: la Cloud API solo permite ENVIAR. Los mensajes entrantes llegan
# por webhook, no hay endpoint para leer el historial.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=

# --- Meta Graph API: páginas y anuncios ------------------------------
# Token de usuario o de sistema con permisos:
#   pages_read_engagement, pages_show_list, read_insights
#   pages_manage_posts   (solo si usarás modo ejecución)
#   ads_read             (solo si vas a consultar campañas)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_AD_ACCOUNT_ID=act_

# --- Comportamiento de la junta --------------------------------------
# true  = la junta solo lee y recomienda (recomendado, es el valor por defecto)
# false = la junta puede enviar WhatsApp, correos y publicar en Meta
JUNTA_MODO_LECTURA=true

# Modelos. Por defecto claude-opus-5 para todos. Para abaratar la
# operación, los consejeros pueden bajarse a claude-sonnet-5.
JUNTA_MODELO_PRESIDENCIA=claude-opus-5
JUNTA_MODELO_CONSEJEROS=claude-opus-5

# Profundidad de razonamiento: low | medium | high | xhigh | max
JUNTA_ESFUERZO=high

# Tope de turnos por deliberación
JUNTA_MAX_TURNOS=60

# Versión de la Graph API de Meta (WhatsApp y Meta la comparten)
GRAPH_API_VERSION=v21.0
